# Neon / production-like local development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEON_BRANCH=production

# Optional: make the local API proxy requests to the deployed Cloudflare Worker.
CLOUDFLARE_API_BASE_URL="https://tabnews.<YOUR_SUBDOMAIN>.workers.dev"

# Cloudflare local preview (copy this value to .dev.vars as DATABASE_URL)
# Production: configure with `npx wrangler secret put DATABASE_URL`.

# Legacy local Docker Postgres (not used by the Cloudflare/Neon runtime)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password
POSTGRES_ROOT_PASSWORD=local_password
